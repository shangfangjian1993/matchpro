# 必填:openssl rand -hex 32 生成(未设置时 API 拒绝启动,compose 直接报错)
JWT_SECRET_KEY=
# 管理员初始密码(必填;首次启动时创建 admin 账号,未设置则 API 拒绝启动)
ADMIN_PASSWORD=
# 数据库账号(必填;postgres 不暴露宿主端口)
POSTGRES_USER=football
POSTGRES_PASSWORD=

# JWT 有效期(小时,默认 24)
JWT_EXPIRES_HOURS=24
# CORS 允许来源(逗号分隔;默认 localhost:3000;跨源部署时填实际前端地址)
CORS_ORIGINS=http://localhost:3000
# 可选:Redis 地址(设置后限流跨 worker 共享计数;不设则进程内计数)
REDIS_URL=

# 限流反向代理感知:API 部署在前端 server.js(或 nginx)之后时,默认信任
# X-Forwarded-For(取最左条目)识别真实客户端 IP;直连部署(无代理)时设 false
RATELIMIT_X_FORWARDED_FOR=true
# 公网部署:不要直接暴露 API 8000 端口(客户端可伪造 XFF 绕过 IP 限流;
# 登录端点另有按用户名限流兜底)

# api-football(api-sports.io)伤停数据 key(Free 套餐每日 100 次;用于 data/injuries 采集)
API_FOOTBALL_KEY=
